{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Amazon": "Information",
      "AWSSDK": "Information"
    }
  },
  "AllowedHosts": "*",
  "XRay": {
    "AWSXRayPlugins": "EC2Plugin",
    "ContextMissingStrategy": "LOG_ERROR"
  }
}
