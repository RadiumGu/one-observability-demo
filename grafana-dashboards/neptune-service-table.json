          "rawQuery": true,
          "rawSql": "SELECT count() AS total_calls\nFROM flow_log.l7_flow_log\nWHERE toUnixTimestamp64Milli(start_time) BETWEEN $__from AND $__to\n  AND l7_protocol != 120\n  AND (request_resource IS NULL OR request_resource NOT IN ('/metrics', '/'))",
          "refId": "A"
        }
      ],
      "title": "Total L7 Calls",
