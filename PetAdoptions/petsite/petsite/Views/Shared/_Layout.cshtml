@using Microsoft.AspNetCore.Html
@using PetSite.Configuration
@inject ParameterRefreshManager RefreshManager
@{
    // RUM 脚本经 ParameterRefreshManager 读取（默认 300 秒缓存）。
    //
    // 原实现有五个叠加问题，合起来造成**每分钟约 42 次无效 SSM 调用**
    // （CloudTrail 实测 50 条 GetParameter 里 49 条是它）：
    //
    //  ① 参数名写死成 "/petstore/rumscriptparameter" —— 真实名是 "/petstore/rumscript"，
    //     多了 "parameter" 后缀，每次调用必然 ParameterNotFound。
    //     而 Pod 里本来就有 env RUM_SCRIPT_PARAMETER_NAME=rumscript，代码却没用它。
    //  ② 每次渲染都 `new AmazonSimpleSystemsManagementClient()` —— 客户端不复用，
    //     每个都自带连接池与凭证解析开销。
    //  ③ 完全没有缓存，而这是**共享布局页**，每渲染一个页面就调一次 SSM。
    //  ④ `.Result` 在 Razor 里同步阻塞异步调用，有线程池饥饿风险。
    //  ⑤ `catch { }` 吞掉一切异常 —— 所以这个错误存在很久而始终无人发现，
    //     日志里只留下 AWS SDK 自己打的 ParameterNotFoundException 噪声。
    //
    // 注意：该参数的值是 CDK（services-eks.ts:1057）写入的**单个空格** `' '`，
    // 即 RUM 本就未启用。所以修好名字也只会拿到空白 —— 下面的
    // IsNullOrWhiteSpace 判断因此仍然不会输出任何脚本，行为正确。
    // 修这个的意义在于消除无效调用与日志噪声，而不是启用 RUM。
    string rumScript = "";
    try
    {
        var rumParamName = Environment.GetEnvironmentVariable("RUM_SCRIPT_PARAMETER_NAME") ?? "rumscript";
        rumScript = await RefreshManager.GetParameterAsync(rumParamName);
    }
    catch (Exception)
    {
        // RUM script not available —— 保持静默降级（页面不应因缺 RUM 而挂），
        // 但真实原因现在能从 ParameterRefreshManager 的日志里看到。
    }
}

<!DOCTYPE html>
<html lang="en">

<head>
    @if (!string.IsNullOrWhiteSpace(rumScript))
    {
        @Html.Raw(rumScript)
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Observability PetAdoptions</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300..900&family=Varela+Round&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/petstyles.css" />
    <link rel="stylesheet" href="~/css/waggle-chat.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/petsite-modern.css" asp-append-version="true" />
    @* sets data-theme before paint so there is no flash of the wrong theme *@
    <script src="~/js/petsite-ui.js" asp-append-version="true"></script>
    @* the old .pet-header / .active-page rules went with the black bar; the nav now
       lives in petsite-modern.css *@

</head>

<body>
    <div class="pet-wrapper">
        @{
            var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        }
        <div class="ps-topbar" id="ps-topbar">
            <div class="ps-shell">
                <nav class="ps-nav">
                    <a class="ps-brand" asp-controller="home" asp-action="index" asp-route-userId="@ViewBag.UserId">
                        <span class="ps-logo" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <ellipse cx="12" cy="15.6" rx="4.5" ry="3.8" />
                                <ellipse cx="5.7" cy="9.8" rx="2.2" ry="2.85" transform="rotate(-18 5.7 9.8)" />
                                <ellipse cx="18.3" cy="9.8" rx="2.2" ry="2.85" transform="rotate(18 18.3 9.8)" />
                                <ellipse cx="9.2" cy="5.4" rx="2" ry="2.55" />
                                <ellipse cx="14.8" cy="5.4" rx="2" ry="2.55" />
                            </svg>
                        </span>
                        <span>
                            <span class="ps-brandmark">PetAdoptions</span>
                            <span class="ps-brandsub">Observability</span>
                        </span>
                    </a>

                    <div class="ps-navlinks">
                        <a class="ps-link @(ctrl == "Waggle" ? "ps-on" : "")" asp-controller="Waggle"
                           asp-action="Index" asp-route-userId="@ViewBag.UserId">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2.8l1.45 4.15 4.15 1.55-4.15 1.45L12 14.1l-1.45-4.15L6.4 8.5l4.15-1.55L12 2.8z" />
                                <path d="M18.7 13.6l.8 2.3 2.3.8-2.3.8-.8 2.3-.8-2.3-2.3-.8 2.3-.8.8-2.3z" />
                            </svg> Waggle AI
                        </a>
                        <a class="ps-link @(ctrl == "FoodService" ? "ps-on" : "")" asp-controller="FoodService"
                           asp-action="Index" asp-route-userId="@ViewBag.UserId" asp-route-petType="puppy">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
                                <path d="M4.5 8.5h15l-1.4 10.2H5.9L4.5 8.5zM9.2 8.5V6.4a2.8 2.8 0 015.6 0v2.1" />
                            </svg> Buy Food
                        </a>
                        <a class="ps-link @(ctrl == "PetListAdoptions" ? "ps-on" : "")" id="seeadoptionlist"
                           asp-controller="PetListAdoptions" asp-action="index" asp-route-userId="@ViewBag.UserId">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
                                <path d="M4 6.5h16M4 12h16M4 17.5h10" />
                            </svg> Adoption List
                        </a>
                        <a class="ps-link @(ctrl == "Home" && act == "HouseKeeping" ? "ps-on" : "")"
                           id="performhousekeeping" asp-controller="Home" asp-action="HouseKeeping"
                           asp-route-userId="@ViewBag.UserId">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
                                <path d="M12 3.4l7.5 3.7v5.6c0 4.7-7.5 7.6-7.5 7.6S4.5 17.4 4.5 12.7V7.1z" />
                            </svg> Housekeeping
                        </a>
                    </div>

                    <div class="ps-navact">
                        <button type="button" class="ps-icon" id="ps-theme" title="Switch theme" aria-label="Switch theme">
                            <svg id="ps-theme-icon" viewBox="0 0 24 24"></svg>
                        </button>
                        <a class="ps-icon" asp-controller="Checkout" asp-action="Index"
                           asp-route-userId="@ViewBag.UserId" aria-label="Cart">
                            <svg viewBox="0 0 24 24">
                                <path d="M6.2 6.4h14.3l-1.5 8.6H7.4L6.2 6.4zM6.2 6.4L5.3 3.4H2.4" />
                                <circle cx="9.2" cy="19.6" r="1.5" /><circle cx="17.8" cy="19.6" r="1.5" />
                            </svg>
                            <span id="cart-count" class="ps-badge" style="display: none;"></span>
                        </a>
                    </div>
                </nav>
            </div>
        </div>
        <main class="ps-main">
            @RenderBody()
        </main>

        <footer class="ps-footer">
            <div class="ps-shell">
                Built with ❤️ in association with
                <a href="https://kiro.dev/" target="_blank" rel="noopener">Kiro</a>
            </div>
        </footer>

    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/waggle-chat.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            // Update cart count on every page load
            var userId = '@ViewBag.UserId';
            if (userId) {
                $.ajax({
                    url: '/FoodService/GetCartCount',
                    type: 'GET',
                    data: { userId: userId },
                    success: function (response) {
                        if (response.totalItems > 0) {
                            $('#cart-count').text(response.totalItems).show();
                        } else {
                            $('#cart-count').hide();
                        }
                    },
                    error: function (xhr) {
                        $('#cart-count').hide();
                    }
                });
            }
        });
    </script>
    @* Floating Waggle chat on every page. Skipped on the full Waggle page, which is
       already a chat — both share the same sessionStorage conversation. *@
    @if (!string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Waggle",
            StringComparison.OrdinalIgnoreCase))
    {
        await Html.RenderPartialAsync("_WaggleWidget");
    }
    @RenderSection("Scripts", required: false)
</body>

</html>