        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "bfdww4i8nxreoc"
          },
          "queryType": "sql",
          "rawQuery": true,
          "rawSql": "SELECT\n    dictGetOrDefault('flow_tag.pod_service_map', 'name', toUInt64(auto_service_id_0), toString(auto_service_id_0)) AS source_service,\n    dictGetOrDefault('flow_tag.pod_service_map', 'name', toUInt64(auto_service_id_1), toString(auto_service_id_1)) AS dest_service,\n    toString(l7_protocol) AS protocol,\n    count() AS calls,\n    round(avg(response_duration) / 1000, 2) AS avg_latency_ms,\n    round(countIf(response_status >= 2) / count() * 100, 2) AS error_pct\nFROM flow_log.l7_flow_log\nWHERE toUnixTimestamp64Milli(start_time) BETWEEN $__from AND $__to\n  AND auto_service_id_0 > 0\n  AND auto_service_id_1 > 0\n  AND l7_protocol != 120\n  AND (request_resource IS NULL OR request_resource NOT IN ('/metrics', '/'))\nGROUP BY source_service, dest_service, protocol\nORDER BY calls DESC\nLIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Service L7 Call Statistics",
      "type": "table"
    }
  ],
  "refresh": "30s",
