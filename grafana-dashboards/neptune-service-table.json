          },
          "queryType": "sql",
          "rawQuery": true,
          "rawSql": "SELECT uniqExact(auto_service_id_0) AS active_services\nFROM flow_log.l7_flow_log\nWHERE toUnixTimestamp64Milli(start_time) BETWEEN $__from AND $__to\n  AND auto_service_id_0 > 0\n  AND l7_protocol != 120",
          "refId": "A"
        }
      ],
      "title": "Active Services",
      "type": "stat"
    },
