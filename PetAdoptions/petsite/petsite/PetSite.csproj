<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <UserSecretsId>a80ee246-1735-4630-bd6a-0fd3d01d8e35</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="compilerconfig.json" />
    <Content Update="wwwroot\css\petstyles.css">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Include="compilerconfig.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.Extensions.Configuration.SystemsManager" Version="6.1.0" />
    <PackageReference Include="AWSSDK.BedrockAgentCore" Version="3.7.500" />
    <PackageReference Include="AWSSDK.BedrockAgentRuntime" Version="3.7.500" />
    <PackageReference Include="AWSSDK.Core" Version="3.7.500" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="3.7.301" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="3.7.500" />

    <!-- ══════════════════════════════════════════════════════════════════════
         以下 10 个包是**本地独有、上游已移除**的，2026-09-04 移植时刻意加回。
         上游删掉它们是因为改用了 ADOT 自动埋点 + 不再用 DataProtection，
         而这两个前提在本环境都不成立 —— 详见每组的理由。
         ══════════════════════════════════════════════════════════════════════ -->

    <!-- ① PaymentController 直接调 SQS / SNS / StepFunctions。
            上游删掉这三个是因为它把支付流程重构了；本地 PaymentController 仍在用，
            丢了这三个包**编译不过**。 -->
    <PackageReference Include="AWSSDK.SQS" Version="3.7.200.50" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="3.7.400.57" />
    <PackageReference Include="AWSSDK.StepFunctions" Version="3.7.200.49" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="3.7.202" />

    <!-- ② X-Ray SDK 四件套 —— **不能删**。
            上游改用了 OpenTelemetry 的 `Activity` API（.NET 内置，无需包），
            由 **ADOT 自动埋点**在运行时注入并导出。
            但本环境的 petsite 是**单容器、无 aws-otel-collector sidecar**
            （2026-08-29 撤回；其余四个服务都还有），遥测出口是集群级的
            `xray-daemon` DaemonSet（default 命名空间，4/4，198 天）
            —— 也就是**只认 X-Ray SDK 的 UDP 2000**。
            删掉这四个包 = petsite 不再产出 trace = 从 X-Ray 服务图消失
            = `etl_xray` 丢掉 petsite 的全部出边 = 依赖图谱静默残缺。
            这正是本 Stage 反复出现的「移植上游反而是回归」那一类。 -->
    <PackageReference Include="AWSSDK.XRay" Version="3.7.201.11" />
    <PackageReference Include="AWSXRayRecorder.Core" Version="2.14.0" />
    <PackageReference Include="AWSXRayRecorder.Handlers.AspNetCore" Version="2.11.0" />
    <PackageReference Include="AWSXRayRecorder.Handlers.AwsSdk" Version="2.12.0" />
    <PackageReference Include="AWSXRayRecorder.Handlers.System.Net" Version="2.11.0" />

    <!-- ③ DataProtection 密钥持久化到 SSM —— **不能删**。
            本地 Startup.cs 有
                services.AddDataProtection()
                    .PersistKeysToAWSSystemsManager("/petstore/dataprotection");
            上游 Startup.cs 里 DataProtection 命中数为 **0**，即完全去掉了。
            去掉的后果：密钥落在容器本地文件系统 —— **2 个副本之间不共享、Pod 重启即丢**，
            防伪令牌（antiforgery）与会话在请求打到另一个副本时失效。
            线上 SSM 里那些 `/petstore/dataprotection/key-*` 参数就是它写的，是活着的机制。 -->
    <PackageReference Include="Amazon.AspNetCore.DataProtection.SSM" Version="3.4.0" />

    <PackageReference Include="BuildBundlerMinifier" Version="3.2.449" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.10" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="9.0.0" />
    <PackageReference Include="prometheus-net" Version="8.2.1" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="prometheus-net.DotNetRuntime" Version="4.4.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="PutParams.cs" />
  </ItemGroup>
  <ItemGroup>
    <_ContentIncludedByDefault Remove="wwwroot\fonts\Montserrat-Bold.eot" />
    <_ContentIncludedByDefault Remove="wwwroot\fonts\Montserrat-Bold.svg" />
    <_ContentIncludedByDefault Remove="wwwroot\fonts\Montserrat-Bold.ttf" />
    <_ContentIncludedByDefault Remove="wwwroot\fonts\Montserrat-Bold.woff" />
    <_ContentIncludedByDefault Remove="wwwroot\fonts\Montserrat-Bold.woff2" />
    <_ContentIncludedByDefault Remove="wwwroot\fonts\Montserrat-Regular.eot" />
    <_ContentIncludedByDefault Remove="wwwroot\fonts\Montserrat-Regular.svg" />
    <_ContentIncludedByDefault Remove="wwwroot\fonts\Montserrat-Regular.ttf" />
    <_ContentIncludedByDefault Remove="wwwroot\fonts\Montserrat-Regular.woff" />
    <_ContentIncludedByDefault Remove="wwwroot\fonts\Montserrat-Regular.woff2" />
  </ItemGroup>
</Project>